# ============================================================
# Local Nuxeo Server Connection Configuration — TEMPLATE
#
# Copy this file to nuxeo-local.properties (untracked, see .gitignore)
# and edit the copy to match your local Nuxeo setup:
#
#   cp config/nuxeo-local.properties.template config/nuxeo-local.properties
#
# The values below are Nuxeo's own well-known local-dev defaults
# (Administrator/Administrator), not a secret for your environment.
# If you change the admin password or set a real Connect token, that
# copy must never be committed — it is git-ignored for exactly that
# reason.
# ============================================================

# Base URL of your local Nuxeo server
NUXEO_URL=http://localhost:8080/nuxeo

# Admin credentials for REST API access
NUXEO_ADMIN_USER=Administrator
NUXEO_ADMIN_PASSWORD=Administrator

# Path to your local Nuxeo server installation
# Used by deploy.sh to copy bundles directly
NUXEO_HOME=/opt/nuxeo/server

# Path where built bundles should be deployed
NUXEO_BUNDLES_DIR=${NUXEO_HOME}/nxserver/bundles

# Hot-reload enabled? Set to true if nuxeo.conf has:
#   org.nuxeo.dev=true
HOT_RELOAD_ENABLED=true

# Studio Project ID (from Nuxeo Studio URL)
# e.g., https://connect.nuxeo.com/nuxeo/site/studio/ide/project/<PROJECT_ID>
STUDIO_PROJECT_ID=your-studio-project-id

# Nuxeo Connect token for Studio sync (optional)
# Generate at: https://connect.nuxeo.com/nuxeo/site/connect/tokens
NUXEO_CONNECT_TOKEN=
