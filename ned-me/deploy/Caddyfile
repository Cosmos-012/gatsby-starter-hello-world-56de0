{$NED_DOMAIN:localhost} {
	encode gzip
	handle_path /api/* { reverse_proxy api:3000 }
	handle_path /auth/* { reverse_proxy keycloak:8080 }
}

# Fichiers (URL présignées) : hôte dédié, sans réécriture de chemin ni d'hôte, sinon la signature S3 est invalide.
files.{$NED_DOMAIN:localhost} {
	reverse_proxy minio:9000
}
